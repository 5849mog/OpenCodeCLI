# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local tool artifacts (mimosa security scan history, zcode plans)
.mimosa/
.zcode/

# bc-wasm build artifacts (generated by CI on each deploy)
/public/wasm/bc.wasm
/public/wasm/bc.js
/tools/bc-wasm/source/
/tools/bc-wasm/build/

# awk-wasm build artifacts (generated by CI on each deploy)
/public/wasm/awk.wasm
/public/wasm/awk.js
/tools/awk-wasm/source/
/tools/awk-wasm/build/

# lua-wasm build artifacts (generated by CI on each deploy)
/public/wasm/lua.wasm
/public/wasm/lua.js
/tools/lua-wasm/source/
/tools/lua-wasm/build/

# sed-wasm build artifacts (generated by CI on each deploy)
/public/wasm/sed.wasm
/public/wasm/sed.js
/tools/sed-wasm/source/
/tools/sed-wasm/build/

# js-wasm (quickjs-emscripten) artifacts — copied by prepare.sh after install
/public/wasm/js.wasm

# esbuild-wasm artifacts (~9MB, copied by tools/esbuild-wasm/prepare.sh on CI)
/public/wasm/esbuild.wasm

# typescript.js 编译器（check_types 引擎，~9MB, copied by tools/tsc/prepare.sh on CI）
/public/wasm/typescript.js

# tslib.js：内置 lib.*.d.ts 打包（~3MB, generated by tools/tsc/prepare.sh on CI）
/public/wasm/tslib.js